; RUN: %tinytc-oc -S -O0 < %s | filecheck %s

; CHECK: %[[#I16:]] = OpTypeInt 16 0
; CHECK: %[[#I64:]] = OpTypeInt 64 0
; CHECK: %[[#F16:]] = OpTypeFloat 16
; CHECK: %[[#I32:]] = OpTypeInt 32 0
; CHECK: %[[#F32:]] = OpTypeFloat 32
; CHECK: %[[#F64:]] = OpTypeFloat 64
; CHECK: %[[#C32:]] = OpTypeVector %[[#F32]] 2
; CHECK: %[[#I32_4:]] = OpTypeVector %[[#I32]] 4

func @ti16(%a: i16) {
    %0 = bitcast %a : f16
    %1 = bitcast %a : bf16
    %2 = bitcast %0 : i16
    %3 = bitcast %1 : i16
; CHECK-LABEL: %[[#]] = OpFunction {{.*}}
; CHECK:       %[[#I16_AS_F16:]] = OpBitcast %[[#F16]] %[[#]]
; CHECK-NEXT: %[[#I16_AS_BF16:]] = OpCopyObject %[[#I16]] %[[#]]
; CHECK-NEXT:             %[[#]] = OpBitcast %[[#I16]] %[[#I16_AS_F16]]
; CHECK-NEXT:             %[[#]] = OpCopyObject %[[#I16]] %[[#I16_AS_BF16]]
}

func @ti32(%a: i32) {
    %0 = bitcast %a : f32
    %1 = bitcast %0 : i32
; CHECK-LABEL: %[[#]] = OpFunction {{.*}}
; CHECK:       %[[#I32_AS_F32:]] = OpBitcast %[[#F32]] %[[#]]
; CHECK-NEXT:             %[[#]] = OpBitcast %[[#I32]] %[[#I32_AS_F32]]
}

func @ti64(%a: i64) {
    %0 = bitcast %a : f64
    %1 = bitcast %a : c32
    %2 = bitcast %0 : i64
    %3 = bitcast %1 : i64
; CHECK-LABEL: %[[#]] = OpFunction {{.*}}
; CHECK:       %[[#I64_AS_F64:]] = OpBitcast %[[#F64]] %[[#]]
; CHECK-NEXT:  %[[#I64_AS_C32:]] = OpBitcast %[[#C32]] %[[#]]
; CHECK-NEXT:             %[[#]] = OpBitcast %[[#I64]] %[[#I64_AS_F64]]
; CHECK-NEXT:             %[[#]] = OpBitcast %[[#I64]] %[[#I64_AS_C32]]
}

func @tfloatcoopmatrix() attributes{subgroup_size=16} {
    %0 = constant 1.0 : coopmatrix<f32x16x4,matrix_a>
    %2 = bitcast %0  : coopmatrix<i32x16x4,matrix_a>
; CHECK-LABEL: %[[#]] = OpFunction {{.*}}
; CHECK:         %[[#R3:]] = OpUndef %[[#I32_4]]
; CHECK-NEXT:  %[[#A3_0:]] = OpCompositeExtract %[[#F32]] %[[#]] 0
; CHECK-NEXT:  %[[#B3_0:]] = OpBitcast %[[#I32]] %[[#A3_0]]
; CHECK-NEXT:  %[[#R3_0:]] = OpCompositeInsert %[[#I32_4]] %[[#B3_0]] %[[#R3]] 0
; CHECK-NEXT:  %[[#A3_1:]] = OpCompositeExtract %[[#F32]] %[[#]] 1
; CHECK-NEXT:  %[[#B3_1:]] = OpBitcast %[[#I32]] %[[#A3_1]]
; CHECK-NEXT:  %[[#R3_1:]] = OpCompositeInsert %[[#I32_4]] %[[#B3_1]] %[[#R3_0]] 1
; CHECK-NEXT:  %[[#A3_2:]] = OpCompositeExtract %[[#F32]] %[[#]] 2
; CHECK-NEXT:  %[[#B3_2:]] = OpBitcast %[[#I32]] %[[#A3_2]]
; CHECK-NEXT:  %[[#R3_2:]] = OpCompositeInsert %[[#I32_4]] %[[#B3_2]] %[[#R3_1]] 2
; CHECK-NEXT:  %[[#A3_3:]] = OpCompositeExtract %[[#F32]] %[[#]] 3
; CHECK-NEXT:  %[[#B3_3:]] = OpBitcast %[[#I32]] %[[#A3_3]]
; CHECK-NEXT:       %[[#]] = OpCompositeInsert %[[#I32_4]] %[[#B3_3]] %[[#R3_2]] 3
}
